   },
   "neutral_rounds": 0
  },
  {
   "name": "temp",
   "kind": "float",
   "author": "seed",
   "added_gen": 0,
   "hypothesis": "Annealing temperature in units of uncovered distances: a move that opens one more hole is accepted with probability exp(-1/temp). Too cold and the walk freezes in a local optimum, too hot and it never closes the last hole.",
   "of": null,
   "default": 0.5,
   "low": 0.05,
   "high": 5.0,
   "log": true,
   "status": "active",
   "value": 0.5
  },
  {
   "name": "width_factor",
   "kind": "float",
   "author": "seed",
   "added_gen": 0,
   "hypothesis": "Marks may sit anywhere in 0..width_factor * T. The best sets stick out beyond v (the published 360-set reaches 1.12 v), so a window above 1 helps, but a wide window wastes most proposals on useless far positions.",
   "of": null,
   "default": 1.25,
   "low": 1.0,
   "high": 2.5,
   "log": false,
   "status": "active",
   "value": 1.25
  },
  {
   "name": "hole_prob",
   "kind": "float",
   "author": "seed",
   "added_gen": 0,
   "hypothesis": "Share of proposals aimed at a missing distance; the rest stay uniform so that the walk can still leave a basin.",
   "of": "hole_directed",
   "default": 0.5,
   "low": 0.05,
   "high": 0.95,
   "log": false,
   "status": "inactive",
   "value": 0.5
  },
