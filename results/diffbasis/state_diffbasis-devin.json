  {
   "name": "wichmann_init",
   "kind": "switch",
   "author": "seed",
   "added_gen": 0,
   "hypothesis": "Starting from Wichmann's complete ruler (ratio about 3) instead of a block plus its multiples (ratio about 4) saves the annealing the climb from 4 to 3, which is most of what a short budget is spent on.",
   "predicted": "large gain at short budgets and large n (-0.3 to -0.8 in score at n = 64, 5 s); shrinking at long budgets",
   "default": false,
   "status": "inactive",
   "value": false,
