    ],
    "runs": 16,
    "generation": 1
   },
   "neutral_rounds": 0
  },
  {
   "name": "restart_from_best",
   "kind": "switch",
   "author": "seed",
   "added_gen": 0,
   "hypothesis": "At a fixed temperature the walk can drift far from the last covering set into a region with many holes; returning to the best set with a small random kick after a long stall keeps the search near good sets.",
   "predicted": "small gain (about -0.02) at long budgets; nothing at short ones, where a stall of stall_iters moves rarely happens",
   "default": false,
   "status": "inactive",
   "value": false,
   "knockout": {
