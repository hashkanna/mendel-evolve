    ],
    "runs": 16,
    "generation": 1
   },
   "neutral_rounds": 0
  },
  {
   "name": "hole_directed",
   "kind": "switch",
   "author": "seed",
   "added_gen": 0,
   "hypothesis": "Near the target only a few distances are missing; moving a mark to x_j +- d for a missing distance d creates that distance for certain, while a uniform position almost never does, so directed proposals close holes far faster.",
   "predicted": "-0.05 to -0.2 in score at n >= 40",
   "default": false,
   "status": "inactive",
   "value": false,
   "knockout": {
